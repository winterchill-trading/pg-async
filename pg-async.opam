opam-version: "2.0"
synopsis: "Non-blocking PostgreSQL client for Async, over libpq"
description:
  "Connections, a bounded pool, typed parameters and row decoders, transactions with serialization retries, migrations, LISTEN/NOTIFY, COPY and metrics. Drives libpq's asynchronous API from the Async scheduler."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/pg-async"
bug-reports: "https://github.com/winterchill-trading/pg-async/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "postgresql"
  "ppx_jane"
  "yojson"
  "uri"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/pg-async.git"
